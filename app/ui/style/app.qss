/* 全局样式表（QSS）。
   颜色一律写成「@ + 令牌名 + @」这种占位符，由 app/ui/__init__.py 按当前主题色板
   填充（色值单一真源在 app/ui/style/theme.py，改色只改那里）。
   资源路径同理写成 @ASSET_DIR@（加载时替换成 assets 目录的绝对路径——
   QSS 以字符串方式加载，相对路径会跟着工作目录跑，必须用绝对路径）。
   ⚠ 注释里不要出现「大写字母被两个 @ 包起来」的完整占位符字样，
   否则会被 tests/test_theme.py 的残留令牌检查抓成漏填的令牌。
   注意：QSS 只支持 C 风格注释，不能写 Python 的三引号或 # 行注释。

   版式基调（2026 重构）：向「编辑器式」界面靠——窗口骨架（菜单栏 / 工具栏 /
   活动栏 / 面板头 / 标签条 / 状态栏）用一档更暗的底色，内容面板用 BG_PANEL，
   两者之间只靠 1px 分隔线划界；控件圆角收小到 5px、间距收紧，
   让按钮和输入框的边界一眼看得清，而不是糊成一片圆角。 */


/* ---------------------------------------------------------------- 基础 */
QWidget {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: @BG_APP@;
}

QMainWindow::separator {
    background: @BORDER_LIGHT@;
    width: 1px;
    height: 1px;
}

/* 内容面板：侧边栏里的一整页（#SidePage）、对话框里的卡片（#Panel）分开管，
   前者贴边不留描边，后者仍是浮起来的一张卡 */
QWidget#SidePage, QWidget#SidePages {
    background: @BG_PANEL@;
    border: none;
}

QWidget#Panel, QFrame#Panel {
    background: @BG_PANEL@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 8px;
}

QWidget#CentralArea {
    background: @BG_APP@;
}

QLabel#PanelTitle {
    font-size: 13px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    padding: 2px 0;
}

/* 对话框里的第一行标题（各对话框均沿用 PanelTitle 这个名字） */
QDialog QLabel#PanelTitle {
    font-size: 20px;
    font-weight: 600;
    color: @TEXT_PRIMARY@;
    padding: 0 0 2px 0;
}

QLabel#Hint, QLabel#Secondary {
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QLabel#Disabled {
    color: @TEXT_DISABLED@;
}

/* 顶栏品牌字样 */
QLabel#Brand {
    color: @TEXT_PRIMARY@;
    font-size: 13px;
    font-weight: 600;
    padding: 0 10px;
}

QLabel#BrandVersion {
    color: @TEXT_DISABLED@;
    font-size: 11px;
    padding: 0 12px;
}

/* ---------------------------------------------------------------- 窗口骨架 */
/* 活动栏：最左边的图标列，和侧边栏之间一条分隔线 */
QWidget#ActivityBar {
    background: @BG_RAIL@;
    border-right: 1px solid @BORDER_LIGHT@;
}

/* 活动栏里「页面组 / 动作组」之间的发丝线（两侧留边，不贴满） */
QFrame#RailSeparator {
    background: @BORDER@;
    border: none;
    margin: 0 9px;
}

/* 面板头 / 内容区顶栏：左边标题或标签条，右边一排图标键 */
QFrame#HeaderBar, QFrame#EditorHeader {
    background: @BG_TABBAR@;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QLabel#HeaderTitle {
    background: transparent;
    color: @TEXT_PRIMARY@;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HeaderMeta {
    background: transparent;
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    padding-right: 8px;
}

/* 图标键：形状与底色全在 common.IconButton.paintEvent 里画，
   这里只兜底把全局 QPushButton 的边框 / 底色清掉（避免叠加出双层边框） */
QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}

QPushButton#IconButton::menu-indicator {
    image: none;
    width: 0;
}

/* 程序内窗口（停靠面板）本体 */
QDockWidget {
    color: @TEXT_SECONDARY@;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget#RailDock {
    background: @BG_RAIL@;
}

/* 原生标题栏只在没有自绘标题栏时兜底 */
QDockWidget::title {
    background: @BG_TABBAR@;
    border-bottom: 1px solid @BORDER_LIGHT@;
    padding: 6px 10px;
    text-align: left;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
    font-weight: 600;
}

/* ---------------------------------------------------------------- 工具栏 */
QToolBar {
    background: @BG_TABBAR@;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    spacing: 4px;
    padding: 5px 10px;
}

QToolBar::separator {
    background: @BORDER@;
    width: 1px;
    margin: 4px 6px;
}

/* ---------------------------------------------------------------- 按钮 */
QPushButton {
    background: @BG_SUBTLE@;
    border: 1px solid @BORDER_CONTROL@;
    border-radius: 5px;
    padding: 4px 12px;
    color: @TEXT_PRIMARY@;
    min-height: 20px;
}

QPushButton:hover {
    background: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QPushButton:pressed {
    background: @BG_CARD@;
}

QPushButton:focus {
    border-color: @PRIMARY@;
}

QPushButton:disabled {
    color: @TEXT_DISABLED@;
    background: @BG_DISABLED@;
    border-color: @BORDER_LIGHT@;
}

QPushButton#Primary {
    background: @PRIMARY@;
    border: 1px solid @PRIMARY@;
    color: @TEXT_ON_ACCENT@;
    font-weight: 600;
}

QPushButton#Primary:hover {
    background: @PRIMARY_HOVER@;
    border-color: @PRIMARY_HOVER@;
}

QPushButton#Primary:pressed {
    background: @PRIMARY_PRESSED@;
    border-color: @PRIMARY_PRESSED@;
}

QPushButton#Primary:disabled {
    background: @PRIMARY_DISABLED_BG@;
    border-color: @PRIMARY_DISABLED_BG@;
    color: @PRIMARY_DISABLED_TEXT@;
}

QPushButton#Danger {
    color: @DANGER@;
    border-color: @DANGER_BORDER@;
    background: @DANGER_BG_DARK@;
}

QPushButton#Danger:hover {
    background: @DANGER_BG@;
    border-color: @DANGER_BORDER_HOVER@;
}

QPushButton#Ghost {
    background: transparent;
    border: 1px solid transparent;
    color: @TEXT_SECONDARY@;
}

QPushButton#Ghost:hover {
    background: @BG_SUBTLE@;
    color: @TEXT_PRIMARY@;
}

QToolButton {
    background: @BG_SUBTLE@;
    border: 1px solid @BORDER_CONTROL@;
    border-radius: 5px;
    padding: 4px 10px;
    color: @TEXT_PRIMARY@;
    min-height: 20px;
}

QToolButton:hover {
    background: @BG_HOVER@;
    border-color: @BORDER_STRONG@;
}

QToolButton:pressed {
    background: @BG_CARD@;
}

QToolButton:checked {
    background: @PRIMARY_LIGHT@;
    border-color: @PRIMARY@;
    color: @PRIMARY_HOVER@;
}

QToolButton:disabled {
    color: @TEXT_DISABLED@;
}

QToolButton::menu-indicator {
    image: url("@ASSET_DIR@/chevron-down.svg");
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 7px;
    width: 12px;
    height: 12px;
}

/* popupMode: 1 = MenuButtonPopup，2 = InstantPopup（「标签筛选」「添加规则」用的就是它）。
   两种都得留出右侧空间，否则倒三角会压在文字上。 */
QToolButton[popupMode="1"], QToolButton[popupMode="2"] {
    padding-right: 26px;
}

/* 带下拉菜单的普通按钮：与其它 QPushButton 同尺寸，右侧给指示箭头留位 */
QPushButton#MenuButton {
    padding-right: 28px;
}

QPushButton#MenuButton::menu-indicator {
    image: url("@ASSET_DIR@/chevron-down.svg");
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 9px;
    width: 12px;
    height: 12px;
}

/* 折叠区块标题（低频选项默认收起） */
QToolButton#SectionToggle {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px 4px;
    color: @TEXT_SECONDARY@;
    font-weight: 600;
    text-align: left;
}

QToolButton#SectionToggle:hover {
    background: @BORDER_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QToolButton#SectionToggle:checked {
    background: transparent;
    border: none;
    color: @TEXT_PRIMARY@;
}

/* 工具栏上的扁平按钮（文字动作）：悬停才浮出一块方底，
   与菜单栏、活动栏的悬停反馈保持一致 */
QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: @TEXT_SECONDARY@;
    padding: 5px 9px;
}

QToolBar QToolButton:hover {
    background: @BG_SUBTLE@;
    border-color: transparent;
    color: @TEXT_PRIMARY@;
}

QToolBar QToolButton:pressed {
    background: @BG_HOVER@;
}

QToolBar QToolButton:checked {
    background: @PRIMARY_LIGHT@;
    border-color: transparent;
    color: @PRIMARY_HOVER@;
}

QToolBar QToolButton:disabled {
    color: @TEXT_TOOLBAR_DISABLED@;
}

/* ---------------------------------------------------------------- 输入 */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @BG_SUBTLE@;
    border: 1px solid @BORDER_CONTROL@;
    border-radius: 5px;
    padding: 4px 8px;
    selection-background-color: @PRIMARY@;
    selection-color: @TEXT_ON_ACCENT@;
    min-height: 20px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: @BORDER_STRONG@;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid @PRIMARY@;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: @BG_DISABLED@;
    color: @TEXT_DISABLED@;
    border-color: @BORDER_LIGHT@;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url("@ASSET_DIR@/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: @PRIMARY_LIGHT@;
    selection-color: @TEXT_PRIMARY@;
    outline: none;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: @BG_HOVER@;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("@ASSET_DIR@/chevron-up.svg");
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("@ASSET_DIR@/chevron-down.svg");
    width: 12px;
    height: 12px;
}

/* 勾选 / 单选：圆角方块 + 亮蓝填充 */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: @TEXT_PRIMARY@;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 4px;
    background: @BORDER_LIGHT@;
}

QCheckBox::indicator:hover {
    border-color: @PRIMARY@;
}

QCheckBox::indicator:checked {
    background: @PRIMARY@;
    border-color: @PRIMARY@;
    image: url("@ASSET_DIR@/check.svg");
}

QCheckBox::indicator:disabled {
    background: @BG_DISABLED@;
    border-color: @BG_SUBTLE@;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    background: @BORDER_LIGHT@;
}

QRadioButton::indicator:hover {
    border-color: @PRIMARY@;
}

QRadioButton::indicator:checked {
    background: @PRIMARY@;
    border-color: @PRIMARY@;
    image: url("@ASSET_DIR@/radio-dot.svg");
}

/* ---------------------------------------------------------------- 表格 */
QTableView {
    background: @BG_PANEL@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 3px;
    gridline-color: @BORDER_LIGHT@;
    selection-background-color: @PRIMARY_LIGHT@;
    selection-color: @TEXT_PRIMARY@;
    alternate-background-color: @BG_TABLE_ALT@;
    outline: none;
}

QTableView::item {
    padding: 3px 6px;
    border: none;
}

/* 顺序不能反：选中态要压在悬停态上面，否则鼠标停在已选中的格子上时，
   那一格会掉回悬停底色，看着像整行高亮被挖了个洞。 */
QTableView::item:hover {
    background: @BORDER_LIGHT@;
}

QTableView::item:selected {
    background: @PRIMARY_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: @BG_SUBTLE@;
    color: @TEXT_SECONDARY@;
    border: none;
    border-right: 1px solid @BORDER_LIGHT@;
    border-bottom: 1px solid @BORDER_LIGHT@;
    padding: 6px 8px;
    font-weight: 500;
}

QHeaderView::section:hover {
    background: @BG_HOVER@;
    color: @TEXT_PRIMARY@;
}

QTableCornerButton::section {
    background: @BG_SUBTLE@;
    border: none;
}

/* ---------------------------------------------------------------- 列表 / 树 */
QListWidget, QTreeWidget, QListView, QTreeView {
    background: @BG_PANEL@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 5px;
    padding: 3px;
    outline: none;
}

QListWidget::item, QListView::item, QTreeWidget::item, QTreeView::item {
    padding: 5px 7px;
    border: none;
    border-radius: 4px;
    color: @TEXT_PRIMARY@;
}

QListWidget::item:hover, QListView::item:hover {
    background: @BG_SUBTLE@;
}

QListWidget::item:selected, QListView::item:selected {
    background: @PRIMARY_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QListWidget::item:disabled, QListView::item:disabled {
    color: @TEXT_DISABLED@;
}

/* 底部面板的冲突清单：贴着面板边，不要卡片描边与内缩 */
QListWidget#ConflictList {
    background: @BG_PANEL@;
    border: none;
    border-radius: 0;
    padding: 2px 4px;
}

/* ---------------------------------------------------------------- 分组框 */
QGroupBox {
    background: @BG_CARD@;
    border: 1px solid @BG_SUBTLE@;
    border-radius: 8px;
    margin-top: 11px;
    padding: 12px 12px 10px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: @TEXT_SECONDARY@;
    font-weight: 600;
}

/* ---------------------------------------------------------------- 标签条 */
QTabBar {
    qproperty-drawBase: 0;
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: @TEXT_SECONDARY@;
    padding: 5px 11px;
    margin: 0;
    border: none;
    border-top: 1px solid transparent;
    border-radius: 3px;
}

QTabBar::tab:hover {
    background: @BG_SUBTLE@;
    color: @TEXT_PRIMARY@;
}

QTabBar::tab:selected {
    background: @TAB_ACTIVE_BG@;
    color: @TEXT_PRIMARY@;
    font-weight: 600;
    border-top: 1px solid @PRIMARY@;
}

/* 底部面板的标签条：和面板头同高，选中项顶边一条蓝线（同 VS Code 面板） */
QTabBar#PanelTabs::tab {
    padding: 5px 10px;
    color: @TEXT_SECONDARY@;
    font-size: 12px;
}

QTabBar#PanelTabs::tab:selected {
    background: @BG_PANEL@;
    border-top: 1px solid @PRIMARY@;
}

/* ---------------------------------------------------------------- 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @DASHED@;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: @SCROLLBAR_HOVER@;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: @DASHED@;
    border-radius: 5px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: @SCROLLBAR_HOVER@;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------------------------------------------------------- 滚动区 */
QScrollArea {
    background: @BG_APP@;
    border: none;
}

QWidget#Canvas {
    background: @BG_APP@;
}

/* 座位表的组标题（颜色也写在 theme.PRINT_CANVAS_QSS 里，导出时换成浅色） */
QLabel#GroupTitle {
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
}

/* ---------------------------------------------------------------- 状态栏 */
QStatusBar {
    background: @BG_TABBAR@;
    border-top: 1px solid @BORDER_LIGHT@;
    color: @TEXT_SECONDARY@;
    min-height: 24px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0 6px;
}

QLabel#StatusWarn {
    color: @DANGER@;
    font-weight: 500;
}

QLabel#StatusOk {
    color: @SUCCESS@;
}

/* ---------------------------------------------------------------- 菜单 */
QMenuBar {
    background: @BG_TABBAR@;
    border: none;
    border-bottom: 1px solid @BORDER_LIGHT@;
    padding: 2px 6px 2px 2px;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 9px;
    margin: 2px 1px;
    border-radius: 4px;
    color: @TEXT_SECONDARY@;
}

QMenuBar::item:selected {
    background: @BG_SUBTLE@;
    color: @TEXT_PRIMARY@;
}

QMenu {
    background: @BG_CARD@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 26px 6px 10px;
    border-radius: 4px;
    color: @TEXT_PRIMARY@;
}

QMenu::item:selected {
    background: @PRIMARY_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QMenu::item:disabled {
    color: @TEXT_DISABLED@;
}

QMenu::separator {
    height: 1px;
    background: @BG_SUBTLE@;
    margin: 5px 8px;
}

QMenu::section {
    background: transparent;
    color: @TEXT_DISABLED@;
    padding: 6px 10px 4px 10px;
}

/* ---------------------------------------------------------------- 进度条 */
QProgressBar {
    background: @BG_SUBTLE@;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: @TEXT_SECONDARY@;
}

QProgressBar::chunk {
    background: @PRIMARY@;
    border-radius: 4px;
}

/* ---------------------------------------------------------------- 提示气泡 */
QToolTip {
    background: @BG_SUBTLE@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 4px;
    padding: 5px 8px;
}

/* ---------------------------------------------------------------- 分隔线 */
QFrame#HLine {
    background: @BORDER_LIGHT@;
    max-height: 1px;
    border: none;
}

QFrame#VLine {
    background: @BORDER_LIGHT@;
    max-width: 1px;
    border: none;
}
